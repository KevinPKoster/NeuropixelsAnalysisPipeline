    "# ============================================================\n",
    "# CELL AA — LONGITUDINAL REACH PSTH TRAJECTORIES\n",
    "# ============================================================\n",
    "# For each triple-tracked unit, plot its reach PSTH across all\n",
    "# three sessions side-by-side. Reveals whether reach responses\n",
    "# strengthen, weaken, shift latency, or stay stable across days.\n",
    "#\n",
    "# Outputs:\n",
    "#   - individual_trajectories.pdf  one page per tracked unit\n",
    "#   - population_trajectory_summary.png  overview across all units\n",
    "# ============================================================\n",
    "import json\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.backends.backend_pdf import PdfPages\n",
    "from pathlib import Path\n",
    "\n",
    "print(\"\\n===== CELL AA — LONGITUDINAL REACH PSTH TRAJECTORIES =====\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# USER EDIT\n",
    "# ------------------------------------------------------------\n",
    "SESSION_ANALYSIS_FOLDERS = [\n",
    "    r\"G:\\Kevin\\2026-03-04_08-31-33\\Record Node 101\\2026-03-04_08-31-33_experiment1_recording1_analysis\",\n",
    "    r\"G:\\Kevin\\2026-03-05_09-27-03\\Record Node 101\\2026-03-05_09-27-03_experiment2_recording1_analysis\",\n",
    "    r\"G:\\Kevin\\2026-03-09_14-29-25\\Record Node 114\\2026-03-09_14-29-25_experiment2_recording1_analysis\",\n",
    "]\n",
    "SESSION_LABELS = [\"Day 1 (03/04)\", \"Day 2 (03/05)\", \"Day 6 (03/09)\"]\n",
    "OUTPUT_BASE = r\"G:\\Kevin\\unit_matching\"\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "output_base = Path(OUTPUT_BASE)\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# LOAD TRIPLETS + FINGERPRINTS\n",
    "# ------------------------------------------------------------\n",
    "triplets_data = np.load(output_base / \"tracked_units_triplets.npz\", allow_pickle=True)\n",
    "session_names = list(triplets_data[\"session_names\"])\n",
    "s0_units = triplets_data[\"s0_units\"]\n",
    "s1_units = triplets_data[\"s1_units\"]\n",
    "s2_units = triplets_data[\"s2_units\"]\n",
    "triplet_scores = triplets_data[\"triplet_score\"]\n",
    "n_tracked = len(s0_units)\n",
    "\n",
    "print(f\"Tracked units: {n_tracked}\")\n",
    "\n",
    "session_fps = []\n",
    "for sf in SESSION_ANALYSIS_FOLDERS:\n",
    "    fp_path = Path(sf) / \"fingerprints\" / \"unit_fingerprints.npz\"\n",
    "    fp = dict(np.load(fp_path, allow_pickle=True))\n",
    "    fp[\"session_name\"] = Path(sf).name\n",
    "    fp[\"session_folder\"] = str(sf)\n",
    "    session_fps.append(fp)\n",
    "\n",
    "if not all(fp[\"has_reach\"] for fp in session_fps):\n",
    "    raise RuntimeError(\"Need reach data in all 3 sessions.\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# EXTRACT REACH PSTHs FOR EACH TRACKED UNIT\n",
    "# ------------------------------------------------------------\n",
    "def get_unit_idx(fp, unit_id):\n",
    "    return int(np.where(fp[\"unit_ids\"] == unit_id)[0][0])\n",
    "\n",
    "# Load centers from each session\n",
    "session_centers = []\n",
    "for fp in session_fps:\n",
    "    centers_path = Path(fp[\"session_folder\"]) / \"qc\" / \"reach_good_in_trial_arrays.npz\"\n",
    "    if centers_path.exists():\n",
    "        session_centers.append(np.load(centers_path)[\"centers\"])\n",
    "    else:\n",
    "        # Fall back to bin indices\n",
    "        session_centers.append(None)\n",
    "\n",
    "# Build per-tracked-unit data\n",
    "tracked_psths = []          # list of (z_s0, z_s1, z_s2)\n",
    "tracked_modulated = []      # list of (mod_s0, mod_s1, mod_s2)\n",
    "tracked_peak_z = []         # list of (pz_s0, pz_s1, pz_s2)\n",
    "tracked_peak_lat = []       # list of (lat_s0, lat_s1, lat_s2)\n",
    "\n",
    "for i in range(n_tracked):\n",
    "    units_per_session = [s0_units[i], s1_units[i], s2_units[i]]\n",
    "    idxs = [get_unit_idx(session_fps[s], units_per_session[s])\n",
    "            for s in range(3)]\n",
    "    psths = [session_fps[s][\"reach_z_mean\"][idxs[s]] for s in range(3)]\n",
    "    mods = [bool(session_fps[s][\"reach_modulated\"][idxs[s]]) for s in range(3)]\n",
    "    pzs = [float(session_fps[s][\"reach_peak_z\"][idxs[s]]) for s in range(3)]\n",
    "    pls = [float(session_fps[s][\"reach_peak_lat\"][idxs[s]]) for s in range(3)]\n",
    "    tracked_psths.append(psths)\n",
    "    tracked_modulated.append(mods)\n",
    "    tracked_peak_z.append(pzs)\n",
    "    tracked_peak_lat.append(pls)\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# PER-UNIT TRAJECTORY PLOTS (PDF)\n",
    "# ------------------------------------------------------------\n",
    "print(f\"\\nGenerating individual trajectory plots...\")\n",
    "\n",
    "colors = [\"C3\", \"C2\", \"C0\"]\n",
    "pdf_path = output_base / \"individual_trajectories.pdf\"\n",
    "\n",
    "with PdfPages(pdf_path) as pdf:\n",
    "    for i in range(n_tracked):\n",
    "        fig, axes = plt.subplots(2, 1, figsize=(12, 7),\n",
    "                                  gridspec_kw={\"height_ratios\": [2, 1]})\n",
    "\n",
    "        unit_ids_str = (f\"S0 unit {int(s0_units[i])} ↔ \"\n",
    "                        f\"S1 unit {int(s1_units[i])} ↔ \"\n",
    "                        f\"S2 unit {int(s2_units[i])}\")\n",
    "        n_mod = sum(tracked_modulated[i])\n",
    "        title = (f\"Tracked unit #{i+1}/{n_tracked} \"\n",
    "                 f\"(triplet score = {triplet_scores[i]:.3f})\\n\"\n",
    "                 f\"{unit_ids_str}  |  \"\n",
    "                 f\"reach-modulated in {n_mod}/3 sessions\")\n",
    "        fig.suptitle(title, fontsize=11, y=1.01)\n",
    "\n",
    "        # Top: overlaid PSTHs\n",
    "        ax = axes[0]\n",
    "        for s in range(3):\n",
    "            z = tracked_psths[i][s]\n",
    "            mod = tracked_modulated[i][s]\n",
    "            peak_z = tracked_peak_z[i][s]\n",
    "            lat = tracked_peak_lat[i][s]\n",
    "            x = (session_centers[s] if session_centers[s] is not None\n",
    "                 and len(session_centers[s]) == len(z) else np.arange(len(z)))\n",
    "            xlabel = (\"Time from reach (s)\"\n",
    "                      if session_centers[s] is not None\n",
    "                      and len(session_centers[s]) == len(z) else \"Bin index\")\n",
    "            label = (f\"{SESSION_LABELS[s]}: \"\n",
    "                     f\"{'MODULATED' if mod else 'unmod'}  \"\n",
    "                     f\"peak={peak_z:+.1f}z @ {lat:.2f}\")\n",
    "            ax.plot(x, z, color=colors[s], lw=1.8, alpha=0.85, label=label)\n",
    "        ax.axhline(0, color=\"gray\", lw=0.5)\n",
    "        if session_centers[0] is not None and len(session_centers[0]) == len(tracked_psths[i][0]):\n",
    "            ax.axvline(0, color=\"black\", lw=0.7, linestyle=\"--\")\n",
    "        ax.set_xlabel(xlabel)\n",
    "        ax.set_ylabel(\"z-score\")\n",
    "        ax.set_title(\"Reach-aligned PSTH across sessions\", fontsize=10)\n",
    "        ax.legend(fontsize=9, loc=\"upper right\")\n",
    "        ax.grid(True, alpha=0.3)\n",
    "\n",
    "        # Bottom: peak z + latency trajectory\n",
    "        ax2 = axes[1]\n",
    "        days = [0, 1, 2]\n",
    "        peak_z_traj = tracked_peak_z[i]\n",
    "        latencies = tracked_peak_lat[i]\n",
    "        ax2_twin = ax2.twinx()\n",
    "\n",
    "        line1 = ax2.plot(days, peak_z_traj, \"o-\", color=\"C3\", lw=2,\n",
    "                          markersize=10, label=\"Peak |z|\")\n",
    "        ax2.axhline(0, color=\"gray\", lw=0.5)\n",
    "        ax2.set_ylabel(\"Peak signed z\", color=\"C3\", fontsize=10)\n",
    "        ax2.tick_params(axis='y', labelcolor=\"C3\")\n",
    "\n",
    "        line2 = ax2_twin.plot(days, latencies, \"s-\", color=\"C0\", lw=2,\n",
    "                               markersize=10, label=\"Peak latency\")\n",
    "        ax2_twin.set_ylabel(\"Peak latency (s)\", color=\"C0\", fontsize=10)\n",
    "        ax2_twin.tick_params(axis='y', labelcolor=\"C0\")\n",
    "\n",
    "        ax2.set_xticks(days)\n",
    "        ax2.set_xticklabels(SESSION_LABELS, fontsize=9)\n",
    "        ax2.set_xlabel(\"Session\")\n",
    "        ax2.set_title(\"Response trajectory: amplitude and latency over days\", fontsize=10)\n",
    "\n",
    "        lines = line1 + line2\n",
    "        ax2.legend(lines, [l.get_label() for l in lines], loc=\"upper left\",\n",
    "                   fontsize=8)\n",
    "        ax2.grid(True, alpha=0.3)\n",
    "\n",
    "        plt.tight_layout()\n",
    "        pdf.savefig(fig, bbox_inches=\"tight\")\n",
    "        plt.close(fig)\n",
    "\n",
    "print(f\"Saved → {pdf_path.name}\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# POPULATION SUMMARY PLOT\n",
    "# ------------------------------------------------------------\n",
    "print(f\"\\nGenerating population summary...\")\n",
    "\n",
    "fig = plt.figure(figsize=(16, 10))\n",
    "gs = fig.add_gridspec(2, 3, hspace=0.35, wspace=0.3)\n",
    "\n",
    "# --- Panel 1: All PSTHs overlaid per session ---\n",
    "for s_i in range(3):\n",
    "    ax = fig.add_subplot(gs[0, s_i])\n",
    "    for i in range(n_tracked):\n",
    "        z = tracked_psths[i][s_i]\n",
    "        x = (session_centers[s_i] if session_centers[s_i] is not None\n",
    "             and len(session_centers[s_i]) == len(z) else np.arange(len(z)))\n",
    "        is_mod = tracked_modulated[i][s_i]\n",
    "        color = \"C3\" if is_mod else \"gray\"\n",
    "        alpha = 0.5 if is_mod else 0.25\n",
    "        ax.plot(x, z, color=color, lw=0.6, alpha=alpha)\n",
    "    # Population mean\n",
    "    psths_session = np.array([tracked_psths[i][s_i] for i in range(n_tracked)])\n",
    "    mean = psths_session.mean(axis=0)\n",
    "    x = (session_centers[s_i] if session_centers[s_i] is not None\n",
    "         and len(session_centers[s_i]) == len(mean) else np.arange(len(mean)))\n",
    "    ax.plot(x, mean, color=\"black\", lw=2, label=f\"mean (n={n_tracked})\")\n",
    "    ax.axhline(0, color=\"gray\", lw=0.5)\n",
    "    if session_centers[s_i] is not None and len(session_centers[s_i]) == len(mean):\n",
    "        ax.axvline(0, color=\"black\", lw=0.7, linestyle=\"--\")\n",
    "    ax.set_title(f\"{SESSION_LABELS[s_i]}: all 18 tracked PSTHs\",\n",
    "                 fontsize=10)\n",
    "    ax.set_xlabel(\"Time from reach (s)\")\n",
    "    ax.set_ylabel(\"z-score\")\n",
    "    ax.legend(fontsize=8)\n",
    "\n",
    "# --- Panel 2: Peak |z| trajectory across days (paired lines) ---\n",
    "ax = fig.add_subplot(gs[1, 0])\n",
    "for i in range(n_tracked):\n",
    "    pz = [tracked_peak_z[i][s] for s in range(3)]\n",
    "    color = (\"C3\" if all(tracked_modulated[i]) else\n",
    "             \"C2\" if any(tracked_modulated[i]) else \"gray\")\n",
    "    ax.plot([0, 1, 2], pz, \"o-\", color=color, alpha=0.5, lw=1, markersize=6)\n",
    "ax.set_xticks([0, 1, 2])\n",
    "ax.set_xticklabels(SESSION_LABELS, fontsize=9)\n",
    "ax.set_ylabel(\"Peak signed z\")\n",
    "ax.set_title(\"Peak |z| per unit across days\\n\"\n",
    "             \"Red = modulated all 3 days, green = some, gray = never\",\n",
    "             fontsize=10)\n",
    "ax.axhline(0, color=\"black\", lw=0.5)\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# --- Panel 3: Peak latency trajectory ---\n",
    "ax = fig.add_subplot(gs[1, 1])\n",
    "for i in range(n_tracked):\n",
    "    if not any(tracked_modulated[i]):\n",
    "        continue  # only plot units that are modulated at some point\n",
    "    lat = [tracked_peak_lat[i][s] for s in range(3)]\n",
    "    color = \"C3\" if all(tracked_modulated[i]) else \"C2\"\n",
    "    ax.plot([0, 1, 2], lat, \"o-\", color=color, alpha=0.5, lw=1, markersize=6)\n",
    "ax.set_xticks([0, 1, 2])\n",
    "ax.set_xticklabels(SESSION_LABELS, fontsize=9)\n",
    "ax.set_ylabel(\"Peak latency (s)\")\n",
    "ax.set_title(\"Peak latency per unit across days\\n\"\n",
    "             \"(only units modulated in at least one session)\",\n",
    "             fontsize=10)\n",
    "ax.axhline(0, color=\"black\", lw=0.5)\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# --- Panel 4: Modulation status matrix ---\n",
    "ax = fig.add_subplot(gs[1, 2])\n",
    "mod_matrix = np.array([[1 if tracked_modulated[i][s] else 0\n",
    "                         for s in range(3)] for i in range(n_tracked)])\n",
    "# Sort by total modulation count, then by which sessions\n",
    "sort_score = mod_matrix.sum(axis=1) * 10 + mod_matrix[:, 0] * 4 + mod_matrix[:, 1] * 2 + mod_matrix[:, 2]\n",
    "order = np.argsort(sort_score)[::-1]\n",
    "ax.imshow(mod_matrix[order], aspect=\"auto\", cmap=\"RdYlBu_r\",\n",
    "          interpolation=\"nearest\")\n",
    "ax.set_yticks(range(n_tracked))\n",
    "ax.set_yticklabels([f\"Unit {i+1}\" for i in range(n_tracked)], fontsize=7)\n",
    "ax.set_xticks(range(3))\n",
    "ax.set_xticklabels(SESSION_LABELS, fontsize=9, rotation=20)\n",
    "ax.set_title(\"Reach modulation status per unit per day\\n(red = modulated, blue = not)\",\n",
    "             fontsize=10)\n",
    "\n",
    "# Add count labels\n",
    "for s in range(3):\n",
    "    n_mod_s = mod_matrix[:, s].sum()\n",
    "    ax.text(s, -0.7, f\"{n_mod_s}/{n_tracked}\\nmod\",\n",
    "            ha=\"center\", va=\"bottom\", fontsize=9, fontweight=\"bold\")\n",
    "\n",
    "plt.suptitle(\n",
    "    f\"Population trajectory of {n_tracked} units tracked across 3 sessions\\n\"\n",
    "    \"Top row: per-session reach PSTH overlays. Bottom: peak amplitude, latency, modulation status.\",\n",
    "    fontsize=11, y=1.02\n",
    ")\n",
    "plt.tight_layout()\n",
    "\n",
    "out_path = output_base / \"population_trajectory_summary.png\"\n",
    "fig.savefig(out_path, dpi=200, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "print(f\"Saved → {out_path.name}\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# SUMMARY STATS\n",
    "# ------------------------------------------------------------\n",
    "print(\"\\n===== POPULATION TRAJECTORY SUMMARY =====\")\n",
    "mod_matrix = np.array([[1 if tracked_modulated[i][s] else 0\n",
    "                         for s in range(3)] for i in range(n_tracked)])\n",
    "print(f\"\\nModulation status across {n_tracked} tracked units:\")\n",
    "print(f\"  Always modulated (3/3):     {(mod_matrix.sum(axis=1) == 3).sum()}\")\n",
    "print(f\"  Modulated 2/3 sessions:     {(mod_matrix.sum(axis=1) == 2).sum()}\")\n",
    "print(f\"  Modulated 1/3 sessions:     {(mod_matrix.sum(axis=1) == 1).sum()}\")\n",
    "print(f\"  Never modulated:            {(mod_matrix.sum(axis=1) == 0).sum()}\")\n",
    "\n",
    "# Per-session modulation counts\n",
    "print(f\"\\nReach-modulated count per session:\")\n",
    "for s in range(3):\n",
    "    print(f\"  {SESSION_LABELS[s]}: {mod_matrix[:, s].sum()} / {n_tracked}\")\n",
    "\n",
    "# Amplitude trajectories: did peak z grow with training?\n",
    "always_mod_idx = np.where(mod_matrix.sum(axis=1) == 3)[0]\n",
    "if len(always_mod_idx) > 1:\n",
    "    print(f\"\\nAmong {len(always_mod_idx)} always-modulated units:\")\n",
    "    pzs = np.array([[tracked_peak_z[i][s] for s in range(3)]\n",
    "                     for i in always_mod_idx])\n",
    "    print(f\"  Median peak z trajectory: \"\n",
    "          f\"{np.median(pzs[:, 0]):.2f} → {np.median(pzs[:, 1]):.2f} → \"\n",
    "          f\"{np.median(pzs[:, 2]):.2f}\")\n",
    "    print(f\"  Mean change (S0→S2):      {(pzs[:, 2] - pzs[:, 0]).mean():+.2f}\")\n",
    "    print(f\"  Units with stronger response on S2 vs S0: \"\n",
    "          f\"{(pzs[:, 2] > pzs[:, 0]).sum()} / {len(always_mod_idx)}\")\n",
    "\n",
    "print(\"\\n===== CELL AA COMPLETE =====\\n\")"
   ]
