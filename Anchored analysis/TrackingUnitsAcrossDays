    "                     pair_12[\"scores\"]))\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# FIND TRIPLE-CONSISTENT MATCHES (triple bijection)\n",
    "# ------------------------------------------------------------\n",
    "print(f\"\\nSearching for triple-consistent matches...\")\n",
    "\n",
    "triplets = []\n",
    "for u_s0 in match_01:  # iterate over units in session 0 that have S0↔S1 match\n",
    "    u_s1 = match_01[u_s0]\n",
    "\n",
    "    # Does S0 also match into S2?\n",
    "    if u_s0 not in match_02:\n",
    "        continue\n",
    "    u_s2_via_02 = match_02[u_s0]\n",
    "\n",
    "    # Does S1's matched unit also match into S2?\n",
