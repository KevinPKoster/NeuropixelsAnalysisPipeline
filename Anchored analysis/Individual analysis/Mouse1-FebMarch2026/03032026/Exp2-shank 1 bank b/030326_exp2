    "import numpy as np\n",
    "from pathlib import Path\n",
    "\n",
    "probe_path = Path(PROBEA_PATH)  # use whatever you set in Cell A\n",
    "\n",
    "# Look at the structure of spike_times\n",
    "spike_times = np.load(probe_path / \"spike_times.npy\").flatten()\n",
    "NP_SAMPLE_RATE = 30000.0\n",
    "\n",
    "# Check distribution\n",
    "print(f\"Total spikes: {len(spike_times)}\")\n",
    "print(f\"Min sample: {spike_times.min()}\")\n",
    "print(f\"Max sample: {spike_times.max()}\")\n",
    "print(f\"Max time (seconds, raw): {spike_times.max() / NP_SAMPLE_RATE:.3f}\")\n",
    "print(f\"Recording duration (canonical): {recording_duration:.3f}\")\n",
    "print(f\"Difference: {spike_times.max() / NP_SAMPLE_RATE - recording_duration:.3f} s\")\n",
    "\n",
    "# Histogram of spike density over time (raw seconds)\n",
    "import matplotlib.pyplot as plt\n",
    "bins = np.arange(0, spike_times.max() / NP_SAMPLE_RATE + 10, 10)\n",
    "counts, _ = np.histogram(spike_times / NP_SAMPLE_RATE, bins=bins)\n",
    "fig, ax = plt.subplots(figsize=(12, 3))\n",
    "ax.plot(bins[:-1], counts)\n",
    "ax.set_xlabel(\"Time from sample 0 (raw seconds)\")\n",
    "ax.set_ylabel(\"Spike count per 10s bin\")\n",
    "ax.set_title(\"Spike density over time (raw spike_times.npy / 30000)\")\n",
    "ax.axvline(recording_duration, color=\"red\", linestyle=\"--\", label=f\"recording_duration = {recording_duration:.0f}s\")\n",
    "ax.axvline(0, color=\"green\", linestyle=\"--\", label=\"t=0\")\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Also load the probe continuous folder and check the timestamps file\n",
    "probe_cont = probe_path.parent  # the .ProbeA folder\n",
    "ts = np.load(probe_cont / \"timestamps.npy\")\n",
    "print(f\"\\nProbe continuous timestamps:\")\n",
    "print(f\"  First: {ts[0]:.6f}\")\n",
    "print(f\"  Last: {ts[-1]:.6f}\")\n",
    "print(f\"  Duration: {ts[-1] - ts[0]:.3f}\")\n",
    "print(f\"  Total samples: {len(ts)}\")"
