    "print(\"\\n===== CELL Y — MATCHED PAIR VISUALIZATION =====\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# USER EDIT\n",
    "# ------------------------------------------------------------\n",
    "SESSION_ANALYSIS_FOLDERS = [\n",
