    "session_fps = []\n",
    "for sf in SESSION_ANALYSIS_FOLDERS:\n",
    "    fp_path = Path(sf) / \"fingerprints\" / \"unit_fingerprints.npz\"\n",
    "    fp = dict(np.load(fp_path, allow_pickle=True))\n",
    "    fp[\"session_name\"] = Path(sf).name\n",
