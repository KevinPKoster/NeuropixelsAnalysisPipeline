    "# ============================================================\n",
    "# CELL Z — UNITS TRACKED ACROSS ALL SESSIONS\n",
    "# ============================================================\n",
    "# Finds units that match across all pairwise comparisons via\n",
    "# triple-bijection. A unit is \"tracked across all days\" only if:\n",
    "#   - A↔B match exists\n",
    "#   - B↔C match exists\n",
    "#   - A↔C match exists\n",
    "#   - All three matches point to consistent unit identities\n",
    "#\n",
    "# Output:\n",
    "#   - tracked_units_triplets.npz\n",
    "#   - visualization PDF with one page per fully-tracked unit\n",
    "# ============================================================\n",
    "import json\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.backends.backend_pdf import PdfPages\n",
    "from pathlib import Path\n",
    "\n",
    "print(\"\\n===== CELL Z — UNITS TRACKED ACROSS ALL SESSIONS =====\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# USER EDIT\n",
    "# ------------------------------------------------------------\n",
    "SESSION_ANALYSIS_FOLDERS = [\n",
    "    r\"G:\\Kevin\\2026-03-04_08-31-33\\Record Node 101\\2026-03-04_08-31-33_experiment1_recording1_analysis\",\n",
    "    r\"G:\\Kevin\\2026-03-05_09-27-03\\Record Node 101\\2026-03-05_09-27-03_experiment2_recording1_analysis\",\n",
    "    r\"G:\\Kevin\\2026-03-09_14-29-25\\Record Node 114\\2026-03-09_14-29-25_experiment2_recording1_analysis\",\n",
    "]\n",
    "OUTPUT_BASE = r\"G:\\Kevin\\unit_matching\"\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "output_base = Path(OUTPUT_BASE)\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# LOAD FINGERPRINTS\n",
    "# ------------------------------------------------------------\n",
    "session_names = []\n",
    "session_fps = []\n",
    "for sf in SESSION_ANALYSIS_FOLDERS:\n",
    "    fp_path = Path(sf) / \"fingerprints\" / \"unit_fingerprints.npz\"\n",
    "    fp = dict(np.load(fp_path, allow_pickle=True))\n",
    "    fp[\"session_name\"] = Path(sf).name\n",
    "    fp[\"session_folder\"] = str(sf)\n",
    "    session_names.append(Path(sf).name)\n",
    "    session_fps.append(fp)\n",
    "print(f\"Loaded {len(session_fps)} session fingerprints\")\n",
    "for i, name in enumerate(session_names):\n",
    "    print(f\"  Session {i}: {name} ({len(session_fps[i]['unit_ids'])} units)\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# LOAD PAIRWISE MATCH FILES\n",
    "# ------------------------------------------------------------\n",
    "def load_pair(name_a, name_b):\n",
    "    path = output_base / f\"matched_pairs_{name_a}__vs__{name_b}.npz\"\n",
    "    if not path.exists():\n",
    "        return None\n",
    "    d = np.load(path, allow_pickle=True)\n",
    "    return dict(d)\n",
    "\n",
    "pair_01 = load_pair(session_names[0], session_names[1])\n",
    "pair_02 = load_pair(session_names[0], session_names[2])\n",
    "pair_12 = load_pair(session_names[1], session_names[2])\n",
    "\n",
    "if pair_01 is None or pair_02 is None or pair_12 is None:\n",
    "    raise RuntimeError(\"Missing pairwise match file(s). Run Cell X first.\")\n",
    "\n",
    "print(f\"\\nPairwise match counts:\")\n",
    "print(f\"  S0 ↔ S1: {len(pair_01['scores'])} matches\")\n",
    "print(f\"  S0 ↔ S2: {len(pair_02['scores'])} matches\")\n",
    "print(f\"  S1 ↔ S2: {len(pair_12['scores'])} matches\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# BUILD MATCH LOOKUP DICTIONARIES\n",
    "# ------------------------------------------------------------\n",
    "# Each: {unit_a: unit_b} for direct lookup\n",
    "match_01 = dict(zip(pair_01[\"session_a_units\"], pair_01[\"session_b_units\"]))\n",
    "match_02 = dict(zip(pair_02[\"session_a_units\"], pair_02[\"session_b_units\"]))\n",
    "match_12 = dict(zip(pair_12[\"session_a_units\"], pair_12[\"session_b_units\"]))\n",
    "\n",
    "# Reverse lookups\n",
    "match_01_rev = dict(zip(pair_01[\"session_b_units\"], pair_01[\"session_a_units\"]))\n",
    "match_02_rev = dict(zip(pair_02[\"session_b_units\"], pair_02[\"session_a_units\"]))\n",
    "match_12_rev = dict(zip(pair_12[\"session_b_units\"], pair_12[\"session_a_units\"]))\n",
    "\n",
    "# Score lookups (for picking best triplet)\n",
    "score_01 = dict(zip(zip(pair_01[\"session_a_units\"], pair_01[\"session_b_units\"]),\n",
    "                     pair_01[\"scores\"]))\n",
    "score_02 = dict(zip(zip(pair_02[\"session_a_units\"], pair_02[\"session_b_units\"]),\n",
    "                     pair_02[\"scores\"]))\n",
